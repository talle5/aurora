{
  "extends": "./tsconfig.proprietary.vite.json",
  "compilerOptions": {
    "paths": {
      "@app/*": [
        "./src/desktop/*",
        "./src/cloud/*",
        "./src/proprietary/*",
        "./src/core/*"
      ],
      "@core/*": ["./src/core/*"]
    }
  },
  "exclude": [
    "src/core/**/*.test.ts*",
    "src/core/**/*.spec.ts*",
  ]
}
